# Environment
SECRET_KEY=replace-with-a-random-value
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Database
DB_NAME=db.sqlite3

# Routing (free public OSRM demo server; no key needed)
ROUTING_URL=https://router.project-osrm.org/route/v1/driving
ROUTING_TIMEOUT_SECONDS=8
ROUTE_CACHE_SECONDS=86400
ROUTE_SIMPLIFY_TOLERANCE=0.0002

# Geocoding (Photon - used only by free-text input and the import command)
PHOTON_URL=https://photon.komoot.io/api
PHOTON_USER_AGENT=fuel-route-planner/1.0-contact-you@example.com
GEOCODE_CACHE_SECONDS=604800
GEOCODE_CACHE_FILE=data/geocode_cache.json
GEOCODE_DELAY_SECONDS=1.1
PHOTON_CONNECT_TIMEOUT_SECONDS=5
PHOTON_TIMEOUT_SECONDS=20
PHOTON_RETRIES=2
PHOTON_MAX_CONSECUTIVE_FAILURES=10

# Planner
STATION_SEARCH_RADIUS_MILES=5
TANK_RANGE_MILES=500
MPG=10
CSV_FILE=fuel-prices-for-be-assessment.csv
